# IMPROV — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# docker compose reads .env automatically from the project root.

# --- Database ---------------------------------------------------------------
DB_NAME=workoutapp
DB_USERNAME=improv

# CHANGE THESE. Generate with:  openssl rand -base64 24
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Runtime ----------------------------------------------------------------
# Host port the web container is published on -> http://localhost:8080
HTTP_PORT=8080

# JVM flags for the api container
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Container timezone. The API stores user timezones explicitly, so UTC here is
# correct and keeps server logs comparable across environments.
TZ=UTC
