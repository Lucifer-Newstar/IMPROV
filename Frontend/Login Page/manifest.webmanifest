{
  "id": "/",
  "name": "IMPROV — Gamified Workout Tracker",
  "short_name": "IMPROV",
  "description": "Track your training, earn XP, level up, and rank up. A web-first workout RPG that runs on real training data.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#090909",
  "theme_color": "#090909",
  "categories": ["health", "fitness", "lifestyle", "games"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Quests",
      "short_name": "Quests",
      "description": "Jump straight to today's quest board",
      "url": "/workout-homepage.html?source=shortcut",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Exercise Library",
      "short_name": "Exercises",
      "description": "Browse exercises by muscle group",
      "url": "/exercises-detail.html?source=shortcut",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
